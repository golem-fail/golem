# macOS
.DS_Store

# Claude Code plans
.claude/plans/

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# For agent research findings, e.g. markdown files and downloaded data files
findings/

# Golem working directory
.golem/

# Test app build artifacts
node_modules/
dist/

# npm wrapper: native binary fetched at install time
npm/vendor/
# npm wrapper: LICENSE copied from repo root by the `prepack` script at pack time
# (root LICENSE stays the single source of truth; this copy is a build artifact)
npm/LICENSE

# Tauri generated platform projects (machine-specific) — ignore
# everything inside, then carve out the two test-app files that carry
# declarations Tauri gives us no other place to put:
#
#   AndroidManifest.xml — the `uses-permission` lines `permissions_*.test`
#     grants via `pm grant`, and the `golem-test://` intent-filter the
#     deep_link flows drive.
#   Info.plist          — the iOS `CFBundleURLTypes` registration of that
#     same scheme, without which `simctl openurl` cannot reach the app.
#
# Neither `init` nor `build` overwrites a file that already exists, so
# committing them is enough to survive a fresh clone. Both files carry
# comments explaining what must not be moved and why.
**/src-tauri/gen/**
!test-app/src-tauri/gen/
!test-app/src-tauri/gen/android/
!test-app/src-tauri/gen/android/app/
!test-app/src-tauri/gen/android/app/src/
!test-app/src-tauri/gen/android/app/src/main/
!test-app/src-tauri/gen/android/app/src/main/AndroidManifest.xml
!test-app/src-tauri/gen/apple/
!test-app/src-tauri/gen/apple/golem-test-app_iOS/
!test-app/src-tauri/gen/apple/golem-test-app_iOS/Info.plist

# Xcode build output
companions/ios/build/

# DerivedData produced by install scripts that build iOS apps via xcodebuild
build/
DerivedData/
