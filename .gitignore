# macOS
.DS_Store

# Claude Code plans
.claude/plans/

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# For agent research findings, e.g. markdown files and downloaded data files
findings/

# Golem working directory
.golem/

# Test app build artifacts
node_modules/
dist/

# npm wrapper: native binary fetched at install time
npm/vendor/
# npm wrapper: LICENSE copied from repo root by the `prepack` script at pack time
# (root LICENSE stays the single source of truth; this copy is a build artifact)
npm/LICENSE

# Tauri generated platform projects (machine-specific) — ignored whole.
#
# There used to be a carve-out here tracking the test app's
# AndroidManifest.xml (and later its iOS Info.plist) for the declarations
# Tauri has no config for. It backfired: git then handed a clone a PARTIAL
# gen/ tree, and `tauri android build` refuses one of those outright
# ("delete the gen/android folder and run tauri android init"), so a fresh
# clone could not build the test app at all. The declarations are now
# re-applied after generation by scripts/patch-test-app-projects.sh, which
# scripts/install-test-app.sh runs before every build. See #22.
**/src-tauri/gen/**

# Xcode build output
companions/ios/build/

# DerivedData produced by install scripts that build iOS apps via xcodebuild
build/
DerivedData/
